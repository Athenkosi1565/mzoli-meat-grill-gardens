# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — create a project at https://supabase.com
# Leave blank to use local placeholder data (menu, events, forms still work in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics — leave empty until you have IDs
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional form spam protection (e.g. Cloudflare Turnstile / reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inbox that should be notified when a form is submitted (server-side only).
# After you connect an email provider (Resend, SendGrid, or Supabase),
# API routes can forward bookings here. Until then, nobody receives the form.
NOTIFY_EMAIL=
BOOKINGS_EMAIL=
FUNCTIONS_EMAIL=

# Admin allow-list emails (comma-separated). Used when Supabase Auth is connected.
ADMIN_EMAILS=owner@example.com
